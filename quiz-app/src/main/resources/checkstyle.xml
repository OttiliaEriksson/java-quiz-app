<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Check Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
    <property name="charset" value="UTF-8"/>

    <!-- Maximum line length is 120 characters -->
    <module name="LineLength">
        <property name="max" value="120"/>
    </module>

    <module name="TreeWalker">
        <!-- Defines that 4 spaces are used for indentation -->
        <module name="Indentation">
            <property name="basicOffset" value="4"/>
            <property name="braceAdjustment" value="0"/>
            <property name="caseIndent" value="4"/>
            <property name="throwsIndent" value="4"/>
            <property name="lineWrappingIndentation" value="4"/>
            <property name="arrayInitIndent" value="4"/>
        </module>

        <!-- Requires that specific classes are imported instead of complete packages -->
        <module name="AvoidStarImport"/>

        <!-- Requires that all imported classes are used -->
        <module name="UnusedImports"/>

        <!-- Advocates for the use of final for variables and parameters that do not change -->
        <module name="FinalParameters"/>
        <module name="FinalLocalVariable"/>

        <!-- Encapsulation and restriction of access -->
        <module name="VisibilityModifier">
            <property name="publicMemberPattern" value="^public .*$"/>
            <!-- Removed properties that caused errors -->
            <property name="allowPublicImmutableFields" value="true"/>
        </module>
    </module>
</module>